@startuml
title Sơ đồ Usecase - Khách vãng lai (Guest)
left to right direction
actor "Khách vãng lai (Guest)" as Guest

package "Tuna Shop - Khách vãng lai" {
  usecase "Duyệt sản phẩm" as UC_Browse
  usecase "Xem chi tiết sản phẩm" as UC_ViewDetail
  usecase "Tìm kiếm sản phẩm" as UC_Search
  usecase "Lọc sản phẩm (Giá, Màu...)" as UC_Filter
  usecase "Xem bài viết/Tin tức" as UC_ReadBlog
  usecase "Quản lý giỏ hàng (Session)" as UC_CartSession
  usecase "Thêm vào giỏ hàng" as UC_AddToCart
  usecase "Xóa khỏi giỏ hàng" as UC_RemoveFromCart
  usecase "Cập nhật số lượng" as UC_UpdateCart
  usecase "Đăng ký tài khoản" as UC_Register
  usecase "Đăng nhập hệ thống" as UC_Login
  usecase "Liên hệ hỗ trợ (Gửi Form)" as UC_Contact
}

Guest --> UC_Browse
Guest --> UC_Search
Guest --> UC_Filter
Guest --> UC_ReadBlog
Guest --> UC_CartSession
Guest --> UC_Register
Guest --> UC_Login
Guest --> UC_Contact

UC_Browse <.. UC_ViewDetail : <<extend>>
UC_CartSession <.. UC_AddToCart : <<extend>>
UC_CartSession <.. UC_RemoveFromCart : <<extend>>
UC_CartSession <.. UC_UpdateCart : <<extend>>
@enduml
